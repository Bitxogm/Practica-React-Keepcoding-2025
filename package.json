{
  "name": "practica-react",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para práctica de React con frontend y backend",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client & npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "install:all": "npm install",
    "clean": "rm -rf node_modules client/node_modules server/node_modules"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}
